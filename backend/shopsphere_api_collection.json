    {
      "name": "3. Products",
      "item": [
        {
          "name": "Create Product with Variants & Specs (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('productId', res.data._id);",
                  "}",
                  "if (res.data && res.data.variants && res.data.variants.length > 0) {",
                  "    pm.collectionVariables.set('variantId', res.data.variants[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ultra Watch Pro Max\",\n  \"description\": \"Titanium case, precision dual-frequency GPS, up to 36 hours battery life, 100m water resistance\",\n  \"price\": 45999,\n  \"category\": \"Electronics\",\n  \"brand\": \"ApexTech\",\n  \"rating\": 4.8,\n  \"specifications\": [\n    { \"name\": \"Display\", \"value\": \"2.0-inch LTPO OLED Always-On\" },\n    { \"name\": \"Case Material\", \"value\": \"Aerospace-grade Titanium\" },\n    { \"name\": \"Battery Life\", \"value\": \"Up to 36 hours\" }\n  ],\n  \"variants\": [\n    {\n      \"sku\": \"WATCH-PRO-TI-ORANGE\",\n      \"title\": \"Natural Titanium / Alpine Loop Orange\",\n      \"color\": \"Titanium\",\n      \"size\": \"49mm\",\n      \"price\": 45999,\n      \"stock\": 15\n    },\n    {\n      \"sku\": \"WATCH-PRO-TI-BLACK\",\n      \"title\": \"Black Titanium / Ocean Band Black\",\n      \"color\": \"Black\",\n      \"size\": \"49mm\",\n      \"price\": 47999,\n      \"stock\": 15\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
