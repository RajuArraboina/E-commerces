          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('customerToken', res.data.token);",
                  "    console.log('Customer token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
